rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.admin == true ||
         request.auth.token.notificationsAdmin == true);
    }

    // Ops collections — server writes via Cloud Functions; admins read/update read flag.
    match /admin_notifications/{id} {
      // Admin Panel uses Firebase Auth; custom claims may be unset — any signed-in admin user can read.
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'is_read', 'isRead']);
      allow create: if false;
      allow delete: if isSignedIn();
    }

    // Centralized admin notifications feed (mirrors admin_notifications).
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'is_read', 'isRead']);
      allow create: if false;
      allow delete: if isSignedIn();
    }

    // Per-user notification inbox (subcollection under notifications/{uid}/items).
    match /notifications/{uid}/items/{itemId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /activity_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stock_alerts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /abandoned_carts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /daily_summaries/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /delivery_tracking/{orderId}/events/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /settings/ops_settings {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Vendor signup pending flag — no password, used for login messaging without Cloud Functions.
    match /vendor_signup_pending/{emailKey} {
      allow read: if true;
      allow create: if
        request.resource.data.pending == true &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('.*@.*');
      allow delete: if isSignedIn();
      allow update: if false;
    }

    // Vendor signup requests — direct Firestore create from vendor app; admin manages.
    match /vendor_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.status == 'pending' &&
        request.resource.data.isApproved == false &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('.*@.*') &&
        request.resource.data.password is string &&
        request.resource.data.password.size() >= 8 &&
        request.resource.data.firstName is string &&
        request.resource.data.firstName.size() > 0 &&
        request.resource.data.lastName is string &&
        request.resource.data.lastName.size() > 0 &&
        request.resource.data.shopName is string &&
        request.resource.data.shopName.size() > 0;
      allow update, delete: if isAdmin();
    }

    // Pending signup flag (no password) — public read for login messaging.
    match /vendor_signup_pending/{emailKey} {
      allow read: if true;
      allow create: if
        request.resource.data.pending == true &&
        request.resource.data.email is string;
      allow delete: if isSignedIn();
      allow update: if false;
    }

    // Vendor app: signed-in user can read/write own vendor doc (by doc id or auth_uid).
    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == vendorId;
      allow update: if isSignedIn() &&
        (request.auth.uid == vendorId ||
         resource.data.auth_uid == request.auth.uid ||
         resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Delivery app: signed-in rider can read/write own profile doc.
    match /delivery_boys/{riderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == riderId;
      allow update: if isSignedIn() && request.auth.uid == riderId;
      allow delete: if isAdmin();
    }

    // App config (maintenance) — any signed-in user can read.
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Default: authenticated access for other collections (tighten per collection later).
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
