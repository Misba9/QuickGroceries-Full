rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.admin == true ||
         request.auth.token.notificationsAdmin == true);
    }

    // Ops collections — server writes via Cloud Functions; admins read/update read flag.
    match /admin_notifications/{id} {
      // Admin Panel uses Firebase Auth; custom claims may be unset — any signed-in admin user can read.
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'is_read']);
      allow create: if false;
      allow delete: if isSignedIn();
    }

    match /activity_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stock_alerts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /abandoned_carts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /daily_summaries/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /delivery_tracking/{orderId}/events/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /settings/ops_settings {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Default: tighten before production — placeholder allows authenticated reads.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
