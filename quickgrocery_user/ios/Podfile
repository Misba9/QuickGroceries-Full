# Xcode 27 supports iOS 15.0 as the minimum deployment target.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Podspecs still declare 12.0/13.0. Xcode 27 rejects anything below 15.0.
      # Leave a higher pod-specific target untouched.
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end

      # permission_handler: enable only the permissions this app requests.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_SPEECH_RECOGNIZER=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end

    # PrivacyInfo.xcprivacy must be a resource, not a compiled source.
    # geocoding_ios (and similar pods) otherwise warn: "no rule to process file".
    if target.respond_to?(:source_build_phase)
      files_to_fix = target.source_build_phase.files.select do |file|
        path = file.file_ref&.path || file.file_ref&.name || ''
        path.end_with?('PrivacyInfo.xcprivacy')
      end
      files_to_fix.each do |file|
        target.source_build_phase.remove_file_reference(file.file_ref)
        unless target.resources_build_phase.files_references.include?(file.file_ref)
          target.resources_build_phase.add_file_reference(file.file_ref)
        end
      end
    end

    # Xcode warns when "Create Symlinks to Header Folders" has no outputs.
    # Do not set always_out_of_date — that forces the script to run every build.
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:name)
      next unless phase.name == 'Create Symlinks to Header Folders'
      next unless phase.respond_to?(:output_paths)

      stamp = '${DERIVED_FILE_DIR}/pods-headers-symlink.stamp'
      phase.output_paths << stamp unless phase.output_paths.include?(stamp)
      phase.always_out_of_date = '0' if phase.respond_to?(:always_out_of_date=)
    end
  end
end
