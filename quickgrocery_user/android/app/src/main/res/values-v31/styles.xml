<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ system splash: brand yellow + centered logo -->
        <item name="android:windowSplashScreenBackground">@color/launch_yellow</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_yellow</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Keep brand yellow — never flash system white behind first Flutter frame. -->
        <item name="android:windowBackground">@color/launch_yellow</item>
    </style>
</resources>
