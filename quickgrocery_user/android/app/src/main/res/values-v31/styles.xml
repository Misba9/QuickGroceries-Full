<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ system splash: brand yellow, no padded icon halo -->
        <item name="android:windowSplashScreenBackground">@color/launch_yellow</item>
        <item name="android:windowSplashScreenAnimatedIcon">@color/launch_yellow</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_yellow</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
